<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>حاسبة ومتابع مصاريف تجهيز وفرش الشقة</title>

    <!-- Google Fonts: Cairo -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Cairo', 'sans-serif'],
                    },
                    colors: {
                        primary: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            200: '#c7d2fe',
                            300: '#a5b4fc',
                            400: '#818cf8',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            800: '#3730a3',
                            900: '#312e81',
                        }
                    }
                }
            }
        }
    </script>

    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- html2pdf.js CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <style>
        * {
            font-family: 'Cairo', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        
        body {
            background-color: #f8fafc;
            color: #1e293b;
            overflow-x: hidden;
            width: 100%;
        }

        /* Custom smooth scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        /* Print styles */
        @media print {
            .no-print {
                display: none !important;
            }
            body {
                background: white !important;
                color: black !important;
            }
            .print-full {
                width: 100% !important;
                max-width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
            }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col antialiased selection:bg-primary-500 selection:text-white pb-20">

    <!-- Top Header Navigation -->
    <header class="bg-white/95 backdrop-blur-md border-b border-slate-200 sticky top-0 z-40 shadow-sm no-print w-full">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 sm:h-20 gap-3">
                
                <!-- Logo & Brand -->
                <div class="flex items-center gap-3 min-w-0">
                    <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-gradient-to-tr from-primary-700 via-primary-600 to-indigo-500 flex items-center justify-center text-white shadow-md shadow-primary-500/30 flex-shrink-0">
                        <i class="fa-solid fa-house-chimney-window text-lg sm:text-2xl"></i>
                    </div>
                    <div class="truncate">
                        <div class="flex items-center gap-2">
                            <h1 class="text-base sm:text-xl font-black text-slate-800 tracking-tight truncate">مصاريف الشقة</h1>
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">محفوظ محلياً</span>
                        </div>
                        <p class="text-xs text-slate-500 hidden sm:block truncate">متابعة إيجار، تأمين، تشطيب، وفرش الشقة بالكامل على جهازك</p>
                    </div>
                </div>

                <!-- Header Actions: Hamburger Menu Trigger -->
                <div class="flex items-center gap-2.5 flex-shrink-0">
                    <button id="sidebarToggleBtn" onclick="toggleSidebar()" type="button" class="px-3.5 py-2 sm:px-4 sm:py-2.5 bg-slate-100 hover:bg-slate-200 active:scale-95 text-slate-700 font-bold rounded-xl border border-slate-200 transition-all flex items-center gap-2 text-xs sm:text-sm cursor-pointer shadow-xs" title="فتح قائمة الخيارات">
                        <i class="fa-solid fa-bars text-primary-600 text-base sm:text-lg"></i>
                        <span class="hidden md:inline">القائمة والخيارات</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Slide-over Drawer Overlay -->
    <div id="sidebarOverlay" onclick="closeSidebar()" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 hidden transition-opacity duration-300 no-print"></div>

    <!-- Slide-over Drawer -->
    <aside id="sidebarDrawer" class="fixed top-0 left-0 bottom-0 w-80 max-w-[85vw] bg-white shadow-2xl z-50 transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col no-print border-r border-slate-200">
        <!-- Sidebar Header -->
        <div class="p-4 sm:p-5 border-b border-slate-100 flex items-center justify-between bg-slate-50">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-xl bg-primary-100 text-primary-700 flex items-center justify-center font-bold">
                    <i class="fa-solid fa-sliders text-sm"></i>
                </div>
                <h3 class="font-extrabold text-slate-800 text-base">خيارات التطبيق</h3>
            </div>
            <button type="button" onclick="closeSidebar()" class="w-8 h-8 rounded-xl flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-200 transition-colors">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <!-- Drawer Content Menu -->
        <div class="flex-1 overflow-y-auto p-4 space-y-3 text-sm">
            
            <!-- Budget setting -->
            <button onclick="openBudgetModal(); closeSidebar();" class="w-full p-3.5 rounded-2xl bg-slate-50 hover:bg-primary-50 text-slate-800 border border-slate-200 flex items-center justify-between transition-all group">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-wallet text-primary-600 text-lg group-hover:scale-110 transition-transform"></i>
                    <span class="font-bold text-xs sm:text-sm">الميزانية التقديرية</span>
                </div>
                <span id="navBudgetBadge" class="font-black text-primary-700 text-xs sm:text-sm bg-primary-100/60 px-2.5 py-1 rounded-lg">0 ج.م</span>
            </button>

            <!-- PDF Report Button -->
            <button onclick="generatePDFReport(); closeSidebar();" class="w-full p-3.5 rounded-2xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 flex items-center gap-3 transition-all font-bold">
                <i class="fa-solid fa-file-pdf text-rose-600 text-lg"></i>
                <span class="text-xs sm:text-sm">تنزيل تقرير PDF شامل</span>
            </button>

            <!-- Export Backup -->
            <button onclick="exportDataToFile(); closeSidebar();" class="w-full p-3.5 rounded-2xl bg-emerald-50/80 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 flex items-center gap-3 transition-all font-bold">
                <i class="fa-solid fa-cloud-arrow-down text-emerald-600 text-lg"></i>
                <span class="text-xs sm:text-sm">تصدير نسخة احتياطية (JSON)</span>
            </button>

            <!-- Import Backup -->
            <label class="w-full p-3.5 rounded-2xl bg-amber-50/80 hover:bg-amber-100 text-amber-900 border border-amber-200 flex items-center gap-3 transition-all font-bold cursor-pointer">
                <i class="fa-solid fa-cloud-arrow-up text-amber-600 text-lg"></i>
                <span class="text-xs sm:text-sm">استيراد ملف نسخة سابقة</span>
                <input type="file" id="importFileInput" accept=".json" class="hidden" onchange="importDataFromFile(event); closeSidebar();">
            </label>

            <!-- Print View -->
            <button onclick="window.print(); closeSidebar();" class="w-full p-3.5 rounded-2xl bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200 flex items-center gap-3 transition-all font-semibold">
                <i class="fa-solid fa-print text-sky-600 text-lg"></i>
                <span class="text-xs sm:text-sm">طباعة كشف المصاريف</span>
            </button>

            <div class="border-t border-slate-200 my-3"></div>

            <!-- Reset Application -->
            <button onclick="confirmResetAll(); closeSidebar();" class="w-full p-3.5 rounded-2xl bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 flex items-center gap-3 transition-all font-bold">
                <i class="fa-solid fa-trash-can text-red-500 text-lg"></i>
                <span class="text-xs sm:text-sm">تصفير كافة البيانات ومسح السجل</span>
            </button>
        </div>

        <!-- Sidebar Footer -->
        <div class="p-4 border-t border-slate-100 bg-slate-50 text-xs text-slate-500 text-center flex items-center justify-center gap-2">
            <i class="fa-solid fa-shield-halved text-emerald-600"></i>
            <span>البيانات مخزنة بأمان على متصفحك محلياً</span>
        </div>
    </aside>

    <!-- Floating Action Button (FAB) for Quick Addition -->
    <button onclick="openExpenseModal()" class="fixed bottom-6 left-6 z-40 bg-gradient-to-r from-primary-600 via-indigo-600 to-primary-700 hover:from-primary-700 hover:to-indigo-800 text-white px-4 sm:px-5 py-3.5 rounded-full shadow-xl shadow-primary-600/40 hover:shadow-2xl hover:scale-105 active:scale-95 transition-all duration-200 flex items-center gap-2 font-black text-sm no-print cursor-pointer" title="إضافة مصروف جديد">
        <i class="fa-solid fa-plus text-base"></i>
        <span>إضافة مصروف</span>
    </button>

    <!-- Main Application Wrapper -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 w-full flex-1">

        <!-- Quick Template Presets for Instant Addition -->
        <section class="mb-6 no-print">
            <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200 shadow-xs flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
                <div class="flex items-center gap-2 text-xs sm:text-sm font-bold text-slate-800">
                    <i class="fa-solid fa-bolt-lightning text-amber-500"></i>
                    <span>إدخال سريع لبنود شائعة:</span>
                </div>
                <div class="flex flex-wrap items-center gap-1.5 w-full md:w-auto">
                    <button onclick="quickAddPreset('مواد بناء وتأسيس (أسمنت/طوب/سباكة)', 'مواد بناء وتأسيس', 'عام للشقة')" class="px-2.5 py-1 text-xs bg-slate-100 hover:bg-primary-50 hover:text-primary-700 text-slate-700 rounded-lg transition-colors border border-slate-200 font-medium">مواد بناء وتأسيس</button>
                    <button onclick="quickAddPreset('تأمين الشقة المسترد', 'عقد وإيجار وتأمين', 'عام للشقة')" class="px-2.5 py-1 text-xs bg-slate-100 hover:bg-primary-50 hover:text-primary-700 text-slate-700 rounded-lg transition-colors border border-slate-200 font-medium">تأمين الشقة</button>
                    <button onclick="quickAddPreset('إيجار شهر مقدم', 'عقد وإيجار وتأمين', 'عام للشقة')" class="px-2.5 py-1 text-xs bg-slate-100 hover:bg-primary-50 hover:text-primary-700 text-slate-700 rounded-lg transition-colors border border-slate-200 font-medium">إيجار مقدم</button>
                    <button onclick="quickAddPreset('دهانات ونقاشة', 'تشطيبات وصيانة', 'عام للشقة')" class="px-2.5 py-1 text-xs bg-slate-100 hover:bg-primary-50 hover:text-primary-700 text-slate-700 rounded-lg transition-colors border border-slate-200 font-medium">نقاشة ودهان</button>
                    <button onclick="quickAddPreset('تجهيزات المطبخ وخزائن', 'أثاث وموبيليات', 'المطبخ')" class="px-2.5 py-1 text-xs bg-slate-100 hover:bg-primary-50 hover:text-primary-700 text-slate-700 rounded-lg transition-colors border border-slate-200 font-medium">خزائن المطبخ</button>
                    <button onclick="quickAddPreset('ثلاجة', 'أجهزة كهربائية', 'المطبخ')" class="px-2.5 py-1 text-xs bg-slate-100 hover:bg-primary-50 hover:text-primary-700 text-slate-700 rounded-lg transition-colors border border-slate-200 font-medium">ثلاجة</button>
                    <button onclick="quickAddPreset('تكييف صالة / غرفة', 'أجهزة كهربائية', 'غرفة المعيشة والصالة')" class="px-2.5 py-1 text-xs bg-slate-100 hover:bg-primary-50 hover:text-primary-700 text-slate-700 rounded-lg transition-colors border border-slate-200 font-medium">تكييف</button>
                    <button onclick="quickAddPreset('غرفة نوم رئيسية', 'أثاث وموبيليات', 'غرفة النوم الرئيسية')" class="px-2.5 py-1 text-xs bg-slate-100 hover:bg-primary-50 hover:text-primary-700 text-slate-700 rounded-lg transition-colors border border-slate-200 font-medium">غرفة نوم</button>
                    <button onclick="quickAddPreset('فرش غرفة 1', 'أثاث وموبيليات', 'غرفة 1')" class="px-2.5 py-1 text-xs bg-slate-100 hover:bg-primary-50 hover:text-primary-700 text-slate-700 rounded-lg transition-colors border border-slate-200 font-medium">غرفة 1</button>
                    <button onclick="quickAddPreset('فرش غرفة 2', 'أثاث وموبيليات', 'غرفة 2')" class="px-2.5 py-1 text-xs bg-slate-100 hover:bg-primary-50 hover:text-primary-700 text-slate-700 rounded-lg transition-colors border border-slate-200 font-medium">غرفة 2</button>
                    <button onclick="quickAddPreset('نقل عفش وتركيب', 'نقل وتركيب', 'عام للشقة')" class="px-2.5 py-1 text-xs bg-slate-100 hover:bg-primary-50 hover:text-primary-700 text-slate-700 rounded-lg transition-colors border border-slate-200 font-medium">نقل العفش</button>
                </div>
            </div>
        </section>

        <!-- Summary KPI Cards -->
        <section class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6">
            
            <!-- Card 1: Total Cost -->
            <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-xs relative overflow-hidden">
                <div class="flex items-center justify-between">
                    <span class="text-xs sm:text-sm font-bold text-slate-500">إجمالي التكلفة</span>
                    <span class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-primary-50 text-primary-600 flex items-center justify-center text-sm sm:text-base">
                        <i class="fa-solid fa-coins"></i>
                    </span>
                </div>
                <div class="mt-2">
                    <div class="text-lg sm:text-2xl font-black text-slate-900 tracking-tight" id="statTotalCost">0 ج.م</div>
                    <span class="text-[11px] text-slate-400 font-medium" id="statItemCount">0 بنود مسجلة</span>
                </div>
                <div class="absolute bottom-0 left-0 right-0 h-1 bg-primary-500"></div>
            </div>

            <!-- Card 2: Total Paid -->
            <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-xs relative overflow-hidden">
                <div class="flex items-center justify-between">
                    <span class="text-xs sm:text-sm font-bold text-slate-500">المدفوع فعلياً</span>
                    <span class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-sm sm:text-base">
                        <i class="fa-solid fa-circle-check"></i>
                    </span>
                </div>
                <div class="mt-2">
                    <div class="text-lg sm:text-2xl font-black text-emerald-600 tracking-tight" id="statTotalPaid">0 ج.م</div>
                    <span class="text-[11px] text-emerald-700 font-medium" id="statPaidPercent">0% تم دفعه كاش</span>
                </div>
                <div class="absolute bottom-0 left-0 right-0 h-1 bg-emerald-500"></div>
            </div>

            <!-- Card 3: Total Remaining -->
            <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-xs relative overflow-hidden">
                <div class="flex items-center justify-between">
                    <span class="text-xs sm:text-sm font-bold text-slate-500">متبقي كأقساط</span>
                    <span class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-sm sm:text-base">
                        <i class="fa-solid fa-hourglass-half"></i>
                    </span>
                </div>
                <div class="mt-2">
                    <div class="text-lg sm:text-2xl font-black text-amber-600 tracking-tight" id="statTotalRemaining">0 ج.م</div>
                    <span class="text-[11px] text-amber-700 font-medium" id="statPendingCount">0 بنود معلقة</span>
                </div>
                <div class="absolute bottom-0 left-0 right-0 h-1 bg-amber-500"></div>
            </div>

            <!-- Card 4: Budget Balance -->
            <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-xs relative overflow-hidden">
                <div class="flex items-center justify-between">
                    <span class="text-xs sm:text-sm font-bold text-slate-500">المتبقي من الميزانية</span>
                    <span class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-sm sm:text-base cursor-pointer" onclick="openBudgetModal()" title="تعديل الميزانية">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </span>
                </div>
                <div class="mt-2">
                    <div class="text-lg sm:text-2xl font-black text-slate-900 tracking-tight" id="statBudgetRemaining">0 ج.م</div>
                    <span class="text-[11px] text-slate-400 font-medium" id="statBudgetStatus">الميزانية غير محددة</span>
                </div>
                <div class="absolute bottom-0 left-0 right-0 h-1 bg-indigo-500" id="budgetProgressBar"></div>
            </div>
        </section>

        <!-- Interactive Analytics Charts (Collapsible / Toggle) -->
        <section class="mb-6">
            <div class="bg-white rounded-2xl border border-slate-200 p-4 sm:p-5 shadow-xs">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-4">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-chart-pie text-primary-600 text-lg"></i>
                        <h2 class="font-extrabold text-slate-800 text-sm sm:text-base">تحليل ومخطط المصاريف</h2>
                    </div>
                    <span class="text-xs text-slate-400 font-medium">تحديث فوري تلقائي</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Category Chart -->
                    <div class="flex flex-col items-center">
                        <h4 class="text-xs font-bold text-slate-600 mb-2">توزيع المصاريف حسب التصنيف</h4>
                        <div class="relative w-full h-56 flex items-center justify-center">
                            <canvas id="categoryChart"></canvas>
                        </div>
                    </div>
                    <!-- Room Chart -->
                    <div class="flex flex-col items-center">
                        <h4 class="text-xs font-bold text-slate-600 mb-2">توزيع المصاريف حسب الغرف والأماكن</h4>
                        <div class="relative w-full h-56 flex items-center justify-center">
                            <canvas id="roomChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Views Navigation & Filters Bar -->
        <section class="bg-white rounded-2xl border border-slate-200 p-4 shadow-xs mb-6">
            <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
                
                <!-- View Tabs -->
                <div class="flex items-center bg-slate-100 p-1 rounded-xl gap-1 self-start sm:self-auto w-full sm:w-auto overflow-x-auto">
                    <button onclick="switchView('table')" id="tabBtnTable" class="flex-1 sm:flex-initial px-3.5 py-1.5 text-xs font-extrabold rounded-lg transition-all text-primary-700 bg-white shadow-xs">
                        <i class="fa-solid fa-list-check ml-1.5"></i>جدول المصاريف
                    </button>
                    <button onclick="switchView('rooms')" id="tabBtnRooms" class="flex-1 sm:flex-initial px-3.5 py-1.5 text-xs font-extrabold rounded-lg transition-all text-slate-600 hover:text-slate-900">
                        <i class="fa-solid fa-door-open ml-1.5"></i>تقسيم الغرف
                    </button>
                    <button onclick="switchView('pending')" id="tabBtnPending" class="flex-1 sm:flex-initial px-3.5 py-1.5 text-xs font-extrabold rounded-lg transition-all text-slate-600 hover:text-slate-900">
                        <i class="fa-solid fa-clock-rotate-left ml-1.5"></i>الأقساط المتبقية
                    </button>
                </div>

                <!-- Filters & Search Toolbar -->
                <div class="flex flex-wrap sm:flex-nowrap items-center gap-2 w-full lg:w-auto">
                    <!-- Search Input -->
                    <div class="relative w-full sm:w-56">
                        <input type="text" id="searchInput" oninput="applyFilters()" placeholder="بحث في المصاريف..." class="w-full pr-8 pl-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 focus:bg-white text-slate-800 placeholder-slate-400">
                        <i class="fa-solid fa-magnifying-glass absolute right-2.5 top-3 text-slate-400 text-xs"></i>
                    </div>

                    <!-- Category Filter -->
                    <select id="categoryFilter" onchange="applyFilters()" class="flex-1 sm:w-auto px-2.5 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 text-slate-700 font-medium">
                        <option value="">كل الفئات</option>
                        <option value="مواد بناء وتأسيس">مواد بناء وتأسيس</option>
                        <option value="عقد وإيجار وتأمين">عقد وإيجار وتأمين</option>
                        <option value="تشطيبات وصيانة">تشطيبات وصيانة</option>
                        <option value="أجهزة كهربائية">أجهزة كهربائية</option>
                        <option value="أثاث وموبيليات">أثاث وموبيليات</option>
                        <option value="أدوات ومفروشات">أدوات ومفروشات</option>
                        <option value="ديكور وإضاءة">ديكور وإضاءة</option>
                        <option value="نقل وتركيب">نقل وتركيب</option>
                        <option value="أخرى">أخرى ونثريات</option>
                    </select>

                    <!-- Room Filter with updated "غرفة 1" and "غرفة 2" -->
                    <select id="roomFilter" onchange="applyFilters()" class="flex-1 sm:w-auto px-2.5 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 text-slate-700 font-medium">
