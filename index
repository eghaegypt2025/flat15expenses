    <script>
        // Storage Keys for Local State
        const STORAGE_EXPENSES = 'apartment_expenses_list_v3';
        const STORAGE_SETTINGS = 'apartment_settings_info_v3';

        // Core App State
        let expenses = [];
        let appSettings = {
            budget: 0,
            currency: 'ج.م'
        };

        // Navigation State
        let currentView = 'table'; // 'table' | 'rooms' | 'pending'
        let confirmationCallback = null;

        // Chart instances
        let categoryChartInstance = null;
        let roomChartInstance = null;

        // Initial App Bootstrap
        window.addEventListener('DOMContentLoaded', () => {
            loadStoredData();
            initTodayDate();
            renderAll();
        });

        // Initialize today's date in input
        function initTodayDate() {
            const dateInput = document.getElementById('itemDate');
            if (dateInput) {
                const today = new Date().toISOString().split('T')[0];
                dateInput.value = today;
            }
        }

        // Data Storage Handlers
        function loadStoredData() {
            try {
                const savedExpenses = localStorage.getItem(STORAGE_EXPENSES);
                const savedSettings = localStorage.getItem(STORAGE_SETTINGS);

                if (savedExpenses) {
                    expenses = JSON.parse(savedExpenses);
                } else {
                    expenses = []; // Default clean 0 state as requested
                }

                if (savedSettings) {
                    appSettings = JSON.parse(savedSettings);
                } else {
                    appSettings = { budget: 0, currency: 'ج.م' };
                }
            } catch (err) {
                console.error('Error reading localStorage:', err);
                expenses = [];
                appSettings = { budget: 0, currency: 'ج.م' };
            }
        }

        function persistData() {
            try {
                localStorage.setItem(STORAGE_EXPENSES, JSON.stringify(expenses));
                localStorage.setItem(STORAGE_SETTINGS, JSON.stringify(appSettings));
            } catch (err) {
                console.error('Error saving to localStorage:', err);
                showToast('حدث خطأ أثناء حفظ البيانات محلياً', 'error');
            }
        }

        // Sidebar Drawer Controls
        function toggleSidebar() {
            const overlay = document.getElementById('sidebarOverlay');
            const drawer = document.getElementById('sidebarDrawer');
            if (overlay && drawer) {
                if (drawer.classList.contains('-translate-x-full')) {
                    overlay.classList.remove('hidden');
                    setTimeout(() => drawer.classList.remove('-translate-x-full'), 10);
                } else {
                    closeSidebar();
                }
            }
        }

        function closeSidebar() {
            const overlay = document.getElementById('sidebarOverlay');
            const drawer = document.getElementById('sidebarDrawer');
            if (overlay && drawer) {
                drawer.classList.add('-translate-x-full');
                setTimeout(() => overlay.classList.add('hidden'), 250);
            }
        }

        // Tab Switching
        function switchView(viewName) {
            currentView = viewName;
            
            // Buttons UI
            const btnTable = document.getElementById('tabBtnTable');
            const btnRooms = document.getElementById('tabBtnRooms');
            const btnPending = document.getElementById('tabBtnPending');

            [btnTable, btnRooms, btnPending].forEach(btn => {
                btn.className = 'flex-1 sm:flex-initial px-3.5 py-1.5 text-xs font-extrabold rounded-lg transition-all text-slate-600 hover:text-slate-900';
            });

            // Containers
            const tableContainer = document.getElementById('tableViewContainer');
            const roomsContainer = document.getElementById('roomsViewContainer');
            const pendingContainer = document.getElementById('pendingViewContainer');

            tableContainer.classList.add('hidden');
            roomsContainer.classList.add('hidden');
            pendingContainer.classList.add('hidden');

            if (viewName === 'table') {
                btnTable.className = 'flex-1 sm:flex-initial px-3.5 py-1.5 text-xs font-extrabold rounded-lg transition-all text-primary-700 bg-white shadow-xs';
                tableContainer.classList.remove('hidden');
            } else if (viewName === 'rooms') {
                btnRooms.className = 'flex-1 sm:flex-initial px-3.5 py-1.5 text-xs font-extrabold rounded-lg transition-all text-primary-700 bg-white shadow-xs';
                roomsContainer.classList.remove('hidden');
                renderRoomsView();
            } else if (viewName === 'pending') {
                btnPending.className = 'flex-1 sm:flex-initial px-3.5 py-1.5 text-xs font-extrabold rounded-lg transition-all text-primary-700 bg-white shadow-xs';
                pendingContainer.classList.remove('hidden');
                renderPendingView();
            }
        }

        // Main Rendering Orchestrator
        function renderAll() {
            updateKPIs();
            renderTable();
            renderCharts();
            if (currentView === 'rooms') renderRoomsView();
            if (currentView === 'pending') renderPendingView();
        }

        // Format Currency Helper
        function formatMoney(amount) {
            const num = parseFloat(amount) || 0;
            return num.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
        }

        // Update Statistics & KPIs
        function updateKPIs() {
            let totalCost = 0;
            let totalPaid = 0;
            let totalRemaining = 0;
            let pendingItemsCount = 0;

            expenses.forEach(item => {
                const cost = parseFloat(item.totalCost) || 0;
                const paid = parseFloat(item.paidAmount) || 0;
                totalCost += cost;
                totalPaid += paid;
                const rem = Math.max(0, cost - paid);
                totalRemaining += rem;
                if (rem > 0) pendingItemsCount++;
            });

            // Set Values in DOM
            document.getElementById('statTotalCost').innerText = `${formatMoney(totalCost)} ج.م`;
            document.getElementById('statTotalPaid').innerText = `${formatMoney(totalPaid)} ج.م`;
            document.getElementById('statTotalRemaining').innerText = `${formatMoney(totalRemaining)} ج.م`;
            document.getElementById('statItemCount').innerText = `${expenses.length} بنود مسجلة`;
            document.getElementById('statPendingCount').innerText = `${pendingItemsCount} بنود معلقة ومتبقية`;

            // Percentage Paid
            const paidPct = totalCost > 0 ? Math.round((totalPaid / totalCost) * 100) : 0;
            document.getElementById('statPaidPercent').innerText = `${paidPct}% تم دفعه كاش`;

            // Budget Balance
            const targetBudget = parseFloat(appSettings.budget) || 0;
            const navBadge = document.getElementById('navBudgetBadge');
            if (navBadge) navBadge.innerText = `${formatMoney(targetBudget)} ج.م`;

            const budgetRemainingElem = document.getElementById('statBudgetRemaining');
            const budgetStatusElem = document.getElementById('statBudgetStatus');
            const budgetProgressBar = document.getElementById('budgetProgressBar');

            if (targetBudget > 0) {
                const diff = targetBudget - totalCost;
                const budgetUsedPct = Math.min(100, Math.round((totalCost / targetBudget) * 100));

                if (diff >= 0) {
                    budgetRemainingElem.innerText = `${formatMoney(diff)} ج.م`;
                    budgetRemainingElem.className = 'text-lg sm:text-2xl font-black text-slate-900 tracking-tight';
                    budgetStatusElem.innerText = `استهلكت ${budgetUsedPct}% من الميزانية`;
                    budgetProgressBar.className = 'absolute bottom-0 left-0 right-0 h-1 bg-indigo-500';
                } else {
                    budgetRemainingElem.innerText = `عجز: ${formatMoney(Math.abs(diff))} ج.م`;
                    budgetRemainingElem.className = 'text-lg sm:text-2xl font-black text-rose-600 tracking-tight';
                    budgetStatusElem.innerText = `تجاوزت الميزانية بنسبة ${Math.round((totalCost / targetBudget) * 100)}%`;
                    budgetProgressBar.className = 'absolute bottom-0 left-0 right-0 h-1 bg-rose-500';
                }
            } else {
                budgetRemainingElem.innerText = '0 ج.م';
                budgetStatusElem.innerText = 'الميزانية غير محددة (اضغط لتحديدها)';
                budgetProgressBar.className = 'absolute bottom-0 left-0 right-0 h-1 bg-slate-300';
            }
        }

        // Render Table & Mobile Cards
        function renderTable() {
            const tableBody = document.getElementById('expensesTableBody');
            const mobileCards = document.getElementById('expensesMobileCards');
            const emptyState = document.getElementById('emptyState');

            const searchVal = (document.getElementById('searchInput').value || '').trim().toLowerCase();
            const catVal = document.getElementById('categoryFilter').value;
            const roomVal = document.getElementById('roomFilter').value;

            // Filter List
            const filtered = expenses.filter(item => {
                const matchesSearch = !searchVal || 
                    (item.title && item.title.toLowerCase().includes(searchVal)) ||
                    (item.vendor && item.vendor.toLowerCase().includes(searchVal)) ||
