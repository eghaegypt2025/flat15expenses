        // Charts Initialization & Update
        function renderCharts() {
            if (!window.Chart) return;

            // 1. Group by Category
            const catMap = {};
            expenses.forEach(it => {
                const cat = it.category || 'أخرى';
                catMap[cat] = (catMap[cat] || 0) + (parseFloat(it.totalCost) || 0);
            });

            // 2. Group by Room
            const roomMap = {};
            expenses.forEach(it => {
                const room = it.room || 'عام للشقة';
                roomMap[room] = (roomMap[room] || 0) + (parseFloat(it.totalCost) || 0);
            });

            const catLabels = Object.keys(catMap);
            const catData = Object.values(catMap);

            const roomLabels = Object.keys(roomMap);
            const roomData = Object.values(roomMap);

            const chartColors = [
                '#6366f1', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6',
                '#06b6d4', '#f97316', '#3b82f6', '#14b8a6', '#64748b'
            ];

            // Category Chart Canvas
            const catCanvas = document.getElementById('categoryChart');
            if (catCanvas) {
                if (categoryChartInstance) categoryChartInstance.destroy();

                categoryChartInstance = new Chart(catCanvas, {
                    type: 'doughnut',
                    data: {
                        labels: catLabels.length ? catLabels : ['لا توجد بيانات'],
                        datasets: [{
                            data: catData.length ? catData : [1],
                            backgroundColor: catData.length ? chartColors.slice(0, catLabels.length) : ['#e2e8f0'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    font: { family: 'Cairo', size: 11 },
                                    boxWidth: 12
                                }
                            }
                        }
                    }
                });
            }

            // Room Chart Canvas
            const roomCanvas = document.getElementById('roomChart');
            if (roomCanvas) {
                if (roomChartInstance) roomChartInstance.destroy();

                roomChartInstance = new Chart(roomCanvas, {
                    type: 'pie',
                    data: {
                        labels: roomLabels.length ? roomLabels : ['لا توجد بيانات'],
                        datasets: [{
                            data: roomData.length ? roomData : [1],
                            backgroundColor: roomData.length ? chartColors.slice(2, 2 + roomLabels.length) : ['#e2e8f0'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    font: { family: 'Cairo', size: 11 },
                                    boxWidth: 12
                                }
                            }
                        }
                    }
                });
            }
        }

