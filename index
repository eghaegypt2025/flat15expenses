        // Export JSON Backup
        function exportDataToFile() {
            const backupObject = {
                version: '3.0',
                exportDate: new Date().toISOString(),
                settings: appSettings,
                expenses: expenses
            };

            const dataStr = 'data:text/json;charset=utf-8,' + encodeURIComponent(JSON.stringify(backupObject, null, 2));
            const downloadAnchor = document.createElement('a');
            const dateStr = new Date().toISOString().split('T')[0];
            downloadAnchor.setAttribute('href', dataStr);
            downloadAnchor.setAttribute('download', `apartment_expenses_backup_${dateStr}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();

            showToast('تم تحميل ملف النسخة الاحتياطية بنجاح', 'success');
        }

        // Import JSON Backup
        function importDataFromFile(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = (e) => {
                try {
                    const parsed = JSON.parse(e.target.result);
                    if (Array.isArray(parsed.expenses)) {
                        expenses = parsed.expenses;
                        if (parsed.settings) appSettings = parsed.settings;
                    } else if (Array.isArray(parsed)) {
                        expenses = parsed;
                    } else {
                        throw new Error('صيغة ملف غير صالحة');
                    }

                    persistData();
                    renderAll();
                    showToast('تم استعادة البيانات والنسخة الاحتياطية بنجاح', 'success');
                } catch (err) {
                    console.error('Import error:', err);
                    showToast('الملف غير صالح أو تالف', 'error');
                }
                event.target.value = ''; // reset file input
            };
            reader.readAsText(file);
        }

        // PDF Report Generator
        function generatePDFReport() {
            if (expenses.length === 0) {
                showToast('لا توجد مصاريف لتوليد تقرير PDF', 'error');
                return;
            }

            showToast('جاري تجهيز وتحميل ملف تقرير PDF...', 'info');

            let totalCost = 0;
            let totalPaid = 0;
            let totalRemaining = 0;

            expenses.forEach(item => {
                const c = parseFloat(item.totalCost) || 0;
                const p = parseFloat(item.paidAmount) || 0;
                totalCost += c;
                totalPaid += p;
                totalRemaining += Math.max(0, c - p);
            });

            const currentDate = new Date().toLocaleDateString('ar-EG', {
                year: 'numeric', month: 'long', day: 'numeric'
            });

            const targetBudget = parseFloat(appSettings.budget) || 0;

            // Build Printable Template
            const reportHTML = `
                <div style="direction: rtl; font-family: 'Cairo', sans-serif; padding: 24px; color: #1e293b; background: #ffffff;">
                    <!-- Report Header -->
                    <div style="border-bottom: 2px solid #4f46e5; padding-bottom: 16px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <h1 style="font-size: 22px; font-weight: 900; color: #4338ca; margin: 0;">تقرير مصاريف وتجهيز وفرش الشقة</h1>
                            <p style="font-size: 12px; color: #64748b; margin: 4px 0 0 0;">كشف مالي تفصيلي بجميع بنود التعاقد والتشطيبات والأثاث</p>
                        </div>
                        <div style="text-align: left; font-size: 11px; color: #64748b;">
                            <div>تاريخ الإصدار: <strong>${currentDate}</strong></div>
                            <div>إجمالي البنود: <strong>${expenses.length} بند</strong></div>
                        </div>
                    </div>

                    <!-- Summary Cards in PDF -->
                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 24px;">
                        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 12px; text-align: center;">
                            <div style="font-size: 11px; color: #64748b; font-weight: bold;">الميزانية المستهدفة</div>
                            <div style="font-size: 16px; font-weight: 900; color: #1e293b; margin-top: 4px;">${formatMoney(targetBudget)} ج.م</div>
                        </div>
                        <div style="background: #eef2ff; border: 1px solid #c7d2fe; border-radius: 12px; padding: 12px; text-align: center;">
                            <div style="font-size: 11px; color: #4338ca; font-weight: bold;">إجمالي التكلفة</div>
                            <div style="font-size: 16px; font-weight: 900; color: #4338ca; margin-top: 4px;">${formatMoney(totalCost)} ج.م</div>
                        </div>
                        <div style="background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 12px; padding: 12px; text-align: center;">
                            <div style="font-size: 11px; color: #047857; font-weight: bold;">المدفوع كاش</div>
                            <div style="font-size: 16px; font-weight: 900; color: #047857; margin-top: 4px;">${formatMoney(totalPaid)} ج.م</div>
                        </div>
                        <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 12px; padding: 12px; text-align: center;">
                            <div style="font-size: 11px; color: #b45309; font-weight: bold;">المتبقي كأقساط</div>
                            <div style="font-size: 16px; font-weight: 900; color: #b45309; margin-top: 4px;">${formatMoney(totalRemaining)} ج.م</div>
                        </div>
                    </div>

                    <!-- Expenses Table -->
                    <table style="width: 100%; border-collapse: collapse; font-size: 11px; text-align: right; margin-bottom: 20px;">
                        <thead>
                            <tr style="background-color: #f1f5f9; color: #334155; border-bottom: 1px solid #cbd5e1;">
                                <th style="padding: 8px 10px;">البند</th>
                                <th style="padding: 8px 10px;">الفئة</th>
                                <th style="padding: 8px 10px;">المكان</th>
                                <th style="padding: 8px 10px;">التكلفة</th>
                                <th style="padding: 8px 10px;">المدفوع</th>
                                <th style="padding: 8px 10px;">المتبقي</th>
                                <th style="padding: 8px 10px;">المورد/ملاحظات</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${expenses.map((item, idx) => {
                                const c = parseFloat(item.totalCost) || 0;
                                const p = parseFloat(item.paidAmount) || 0;
                                const r = Math.max(0, c - p);
                                const bg = idx % 2 === 0 ? '#ffffff' : '#f8fafc';
                                return `
                                    <tr style="background-color: ${bg}; border-bottom: 1px solid #e2e8f0;">
                                        <td style="padding: 8px 10px; font-weight: bold;">${escapeHtml(item.title)}</td>
                                        <td style="padding: 8px 10px;">${escapeHtml(item.category)}</td>
                                        <td style="padding: 8px 10px;">${escapeHtml(item.room)}</td>
                                        <td style="padding: 8px 10px; font-weight: bold; color: #1e293b;">${formatMoney(c)} ج.م</td>
                                        <td style="padding: 8px 10px; color: #059669;">${formatMoney(p)} ج.م</td>
                                        <td style="padding: 8px 10px; color: ${r > 0 ? '#d97706' : '#94a3b8'};">${formatMoney(r)} ج.م</td>
                                        <td style="padding: 8px 10px; font-size: 10px; color: #64748b;">${escapeHtml(item.vendor || '')} ${item.notes ? `(${escapeHtml(item.notes)})` : ''}</td>
                                    </tr>
                                `;
                            }).join('')}
                        </tbody>
                        <tfoot>
                            <tr style="background-color: #f1f5f9; font-weight: 900; border-top: 2px solid #94a3b8;">
                                <td style="padding: 10px;" colspan="3">الإجمالي العام لجميع البنود:</td>
                                <td style="padding: 10px; color: #1e293b;">${formatMoney(totalCost)} ج.م</td>
                                <td style="padding: 10px; color: #059669;">${formatMoney(totalPaid)} ج.م</td>
                                <td style="padding: 10px; color: #d97706;">${formatMoney(totalRemaining)} ج.م</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>

                    <div style="text-align: center; font-size: 10px; color: #94a3b8; border-top: 1px dashed #cbd5e1; padding-top: 12px;">
                        تم استخراج هذا التقرير تلقائياً عبر تطبيق حاسبة ومتابع مصاريف الشقة
                    </div>
                </div>
            `;

            const pdfContainer = document.getElementById('pdfPrintableReport');
            pdfContainer.innerHTML = reportHTML;

            const opt = {
                margin: 8,
                filename: `تقرير_مصاريف_الشقة_${new Date().toISOString().split('T')[0]}.pdf`,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2, useCORS: true },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            if (window.html2pdf) {
                html2pdf().set(opt).from(pdfContainer).save().then(() => {
                    pdfContainer.innerHTML = '';
                    showToast('تم تحميل ملف PDF بنجاح', 'success');
                }).catch(err => {
                    console.error('PDF generation error:', err);
                    window.print();
                });
            } else {
                // Fallback to print
                window.print();
            }
        }

        // Helper: Toast Notifications
        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            if (!container) return;

            const toast = document.createElement('div');
            let bg = 'bg-slate-800 text-white';
            let icon = 'fa-info-circle text-sky-400';

            if (type === 'success') {
                bg = 'bg-emerald-700 text-white';
                icon = 'fa-circle-check text-white';
            } else if (type === 'error') {
                bg = 'bg-rose-700 text-white';
                icon = 'fa-triangle-exclamation text-white';
            }

            toast.className = `flex items-center gap-2.5 px-4 py-3 rounded-2xl shadow-xl ${bg} text-xs font-bold transform transition-all duration-300 translate-y-2 opacity-0 pointer-events-auto`;
            toast.innerHTML = `<i class="fa-solid ${icon}"></i><span>${escapeHtml(message)}</span>`;

            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('opacity-0', '-translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        // Helper: Escape HTML string
        function escapeHtml(text) {
            if (!text) return '';
            const map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return String(text).replace(/[&<>"']/g, m => map[m]);
        }
    </script>
</body>
</html>
