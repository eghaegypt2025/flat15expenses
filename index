        // Calculate Modal Remaining Preview
        function calculateModalRemaining() {
            const total = parseFloat(document.getElementById('itemTotalCost').value) || 0;
            const paid = parseFloat(document.getElementById('itemPaidAmount').value) || 0;
            const remaining = Math.max(0, total - paid);
            const elem = document.getElementById('modalRemainingPreview');
            if (elem) elem.innerText = `${formatMoney(remaining)} ج.م`;
        }

        // Handle Save Form
        function handleSaveExpense(event) {
            event.preventDefault();

            const editId = document.getElementById('editExpenseId').value;
            const title = document.getElementById('itemTitle').value.trim();
            const category = document.getElementById('itemCategory').value;
            const room = document.getElementById('itemRoom').value;
            const totalCost = parseFloat(document.getElementById('itemTotalCost').value) || 0;
            const paidAmount = parseFloat(document.getElementById('itemPaidAmount').value) || 0;
            const date = document.getElementById('itemDate').value;
            const vendor = document.getElementById('itemVendor').value.trim();
            const notes = document.getElementById('itemNotes').value.trim();

            if (!title) {
                showToast('يرجى كتابة اسم البند أو المصروف', 'error');
                return;
            }

            if (editId) {
                // Update
                const index = expenses.findIndex(x => x.id === editId);
                if (index !== -1) {
                    expenses[index] = {
                        ...expenses[index],
                        title, category, room, totalCost, paidAmount, date, vendor, notes
                    };
                    showToast('تم تحديث بيانات المصروف بنجاح', 'success');
                }
            } else {
                // Insert New
                const newItem = {
                    id: 'exp_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5),
                    title, category, room, totalCost, paidAmount, date, vendor, notes,
                    createdAt: new Date().toISOString()
                };
                expenses.unshift(newItem);
                showToast('تم إضافة المصروف بنجاح', 'success');
            }

            persistData();
            closeExpenseModal();
            renderAll();
        }

        // Delete Single Expense
        function deleteExpense(id) {
            const item = expenses.find(x => x.id === id);
            if (!item) return;

            showConfirmModal(
                'حذف المصروف',
                `هل أنت متأكد من حذف بند "${item.title}" نهائياً؟`,
                () => {
                    expenses = expenses.filter(x => x.id !== id);
                    persistData();
                    renderAll();
                    showToast('تم حذف المصروف', 'info');
                }
            );
        }

        // Directly Pay Remaining Balance
        function payRemainingDirectly(id) {
            const index = expenses.findIndex(x => x.id === id);
            if (index === -1) return;

            const item = expenses[index];
            const cost = parseFloat(item.totalCost) || 0;
            item.paidAmount = cost; // fully paid
            persistData();
            renderAll();
            showToast(`تم تسديد كامل متبقي "${item.title}" بنجاح`, 'success');
        }

